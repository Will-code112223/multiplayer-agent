{
  "name": "multiplayergpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A multiplayer agent session server - many people, one live agent.",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "SERVER_PORT=8787 tsx watch server/index.ts",
    "dev:web": "vite",
    "start": "node server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node test/session-replay.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
